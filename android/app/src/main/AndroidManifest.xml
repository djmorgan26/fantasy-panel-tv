<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the side panel over whatever is playing. Granted once over adb. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Fetch scores from Sleeper and ESPN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keep the panel alive only while it is on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- "Hey Google, open Fantasy Football" lands here. It shows or hides
             the panel and closes at once, so the game keeps playing. -->
        <activity
            android:name=".ToggleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Hey Google, open Fantasy Scores": the compact score card. -->
        <activity-alias
            android:name=".ScoresAlias"
            android:banner="@drawable/banner_scores"
            android:exported="true"
            android:label="@string/scores_name"
            android:targetActivity=".ToggleActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Shown only if the overlay permission is missing. -->
        <activity
            android:name=".SetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a user-requested fantasy football scores panel over other apps" />
        </service>

        <!-- Control channel for the computer (make tv-config, tv-show, ...).
             Requires DUMP, which only the adb shell and the system hold, so
             other apps on the TV cannot change settings or open the panel. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.djmorgan26.fantasypanel.CONFIG" />
                <action android:name="io.github.djmorgan26.fantasypanel.SHOW" />
                <action android:name="io.github.djmorgan26.fantasypanel.HIDE" />
                <action android:name="io.github.djmorgan26.fantasypanel.TOGGLE" />
                <action android:name="io.github.djmorgan26.fantasypanel.RELOAD" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
